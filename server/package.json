{
    "name": "@any-code/server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "AnyCode HTTP server (hono) — 静态 SPA 的薄 driving adapter，import @any-code/domain。",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts"
        }
    },
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "build": "node esbuild.config.js",
        "start": "node dist/server.mjs",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@any-code/domain": "workspace:*",
        "@hono/node-server": "^1.14.0",
        "hono": "^4.10.0"
    },
    "devDependencies": {
        "esbuild": "^0.27.4",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    }
}
