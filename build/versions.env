# anycode 安装器版本配置（信息性；脚本各自内联同值，便于一键改）
# node LTS 固定版本——nodejs.org/dist 永久保留旧发布，故固定一个已知 LTS
# 比运行时解析 index.json 更简单可靠（非技术用户场景）。
NODE_VERSION=v22.11.0

# pnpm standalone 版本（install.sh / install.ps1 内联同值；根 package.json packageManager 一并同步）
PNPM_VERSION=11.8.0

# 仓库（codeload/raw URL 据此拼）
ORG=anyJohn
REPO=any-code
BRANCH=main
